#!/usr/bin/env python3
"""
main14e_subregion_distance_sensitivity.py

하위 지역별 거리 민감도 분석 스크립트
main14c를 다양한 거리 임계값으로 실행하여 지역별 최적 거리를 찾는 분석

Author: assistant
Date: 2025-08-19
"""

import json
import os
import re
import shutil
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple

import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import seaborn as sns
from matplotlib import font_manager
from mpl_toolkits.mplot3d import Axes3D

# 결과 디렉토리 설정
RESULTS_BASE = Path("results/main14e_subregion_sensitivity")
RESULTS_BASE.mkdir(parents=True, exist_ok=True)

# 분석 대상 지역 및 거리
REGIONS = ["0470", "0480", "0490"]
DISTANCES = [10, 20, 30, 50, 100]  # 미터

# K-factors 정의 (CSV 파일 컬럼 순서와 동일)
BASE_K_FACTORS = [
    "STD_DIP",      # 관경
    "K_age",        # 파이프 연령 계수
    "K_soil",       # 토양 조건 계수
    "K_traffic",    # 교통 하중 계수
    "hoop_stress",  # 원주 응력
    "K_stress",     # 응력 계수
    "K_total"       # 총 위험도 계수
]
OPTIONAL_K_FACTORS = ["K_repair"]  # 재작업 이력 계수
DAMAGE_FACTOR = "D_final"  # 피로 손상 지수

# K-factors 리스트 (CSV 컬럼 순서 유지)
K_FACTORS = BASE_K_FACTORS + [DAMAGE_FACTOR] + OPTIONAL_K_FACTORS

FACTOR_NAMES = {
    "STD_DIP": "관경",
    "K_age": "파이프 연령 계수",
    "K_soil": "토양 조건 계수",
    "K_traffic": "교통 하중 계수",
    "hoop_stress": "원주 응력",
    "K_stress": "응력 계수",
    "K_total": "총 위험도 계수",
    "D_final": "피로 손상 지수",
    "K_repair": "재작업 이력 계수"
}

# 한글 폰트 설정
def setup_korean_font():
    """한글 폰트 설정"""
    system_fonts = font_manager.findSystemFonts()
    korean_fonts = [f for f in system_fonts if 'AppleGothic' in f or 'NanumGothic' in f]
    
    if korean_fonts:
        font_path = korean_fonts[0]
        font_prop = font_manager.FontProperties(fname=font_path)
        plt.rcParams['font.family'] = font_prop.get_name()
        plt.rcParams['axes.unicode_minus'] = False
        return True
    return False


def run_main14c_with_params(region: str, distance: int, distance_dir: Path) -> Dict[str, Any]:
    """
    지정된 지역과 거리로 main14c를 실행하고 결과를 수집
    
    Parameters:
    -----------
    region : str
        하위 지역 코드 (0470, 0480, 0490)
    distance : int
        거리 임계값 (미터)
    distance_dir : Path
        거리별 결과 저장 디렉토리 (예: results/main14e_subregion_sensitivity/distance_10m)
        
    Returns:
    --------
    Dict[str, Any]
        실행 결과 정보
    """
    print(f"\n{'='*60}")
    print(f"main14c 실행 중... (지역: {region}, 거리: {distance}m)")
    print(f"{'='*60}")
    
    # 거리별 디렉토리 생성
    distance_dir.mkdir(parents=True, exist_ok=True)
    
    # 실행 시작 시간
    start_time = time.time()
    
    try:
        # main14c 실행 - distance_dir를 직접 전달
        # main14c가 자동으로 region 서브디렉토리를 생성함
        result = subprocess.run(
            [sys.executable, "src/main14c_subregion_correlations.py", 
             "--region", region,
             "--distance", str(distance),
             "--output-dir", str(distance_dir)],
            capture_output=True,
            text=True,
            check=True,
            timeout=60  # 1분 타임아웃
        )
        
        # 실행 시간 계산
        execution_time = time.time() - start_time
        
        # 결과 파일 경로 (main14c가 생성한 위치)
        region_output_dir = distance_dir / region
        
        # 결과 파싱 (main14c가 생성한 디렉토리에서 직접 읽기)
        analysis_results = parse_subregion_results(region_output_dir)
        
        # 매칭 통계 파싱
        matching_stats = parse_matching_stats_from_output(result.stdout)
        
        # 요약 정보 생성
        summary = {
            "region": region,
            "distance": distance,
            "execution_time": execution_time,
            "matching_stats": matching_stats,
            "correlations": analysis_results.get("correlations", {}),
            "p_values": analysis_results.get("p_values", {}),
            "significant_factors": analysis_results.get("significant_factors", []),
            "timestamp": datetime.now().isoformat()
        }
        
        # 요약 정보를 지역별 디렉토리에 저장
        summary_path = region_output_dir / f"summary_{region}_{distance}m.json"
        with open(summary_path, "w", encoding="utf-8") as f:
            json.dump(summary, f, indent=2, ensure_ascii=False)
        
        print(f"✓ 실행 완료 (실행 시간: {execution_time:.2f}초)")
        if matching_stats:
            print(f"  - 매칭률: {matching_stats.get('matching_rate', 0):.1f}%")
        print(f"  - 유의미한 요인: {len(analysis_results.get('significant_factors', []))}개")
        
        return summary
        
    except subprocess.TimeoutExpired:
        print(f"✗ 실행 시간 초과")
        return {
            "region": region,
            "distance": distance,
            "execution_time": -1,
            "error": "Timeout",
            "timestamp": datetime.now().isoformat()
        }
    except subprocess.CalledProcessError as e:
        print(f"✗ 실행 실패: {e}")
        return {
            "region": region,
            "distance": distance,
            "execution_time": -1,
            "error": str(e),
            "stderr": e.stderr,
            "timestamp": datetime.now().isoformat()
        }


def parse_subregion_results(output_dir: Path) -> Dict[str, Any]:
    """
    하위 지역 분석 결과 파일을 파싱
    
    Parameters:
    -----------
    output_dir : Path
        결과 파일이 있는 디렉토리
        
    Returns:
    --------
    Dict[str, Any]
        파싱된 결과
    """
    results = {
        "correlations": {},
        "p_values": {},
        "significant_factors": []
    }
    
    # 분석 결과 텍스트 파일 파싱
    txt_file = output_dir / "correlation_analysis.txt"
    if txt_file.exists():
        with open(txt_file, "r", encoding="utf-8") as f:
            content = f.read()
        
        # 전략: 가장 가까운 파이프 섹션 찾기
        nearest_section = re.search(r"전략: 가장 가까운 파이프\n(.*?)\n(?:전략:|가장 강한)", content, re.DOTALL)
        if nearest_section:
            nearest_text = nearest_section.group(1)
            
            # 각 요인별로 파싱
            for factor in K_FACTORS:
                factor_name = FACTOR_NAMES.get(factor, factor)
                # "파이프 연령 계수: r=0.0984, p=0.2002" 형식 파싱
                pattern = f"{factor_name}.*?r=([\\-\\d.]+|nan).*?p=([\\d.]+|nan)"
                match = re.search(pattern, nearest_text)
                
                if match:
                    r_str = match.group(1)
                    p_str = match.group(2)
                    
                    if r_str != "nan":
                        r_value = float(r_str)
                        results["correlations"][factor] = r_value
                        
                        if p_str != "nan":
                            p_value = float(p_str)
                            results["p_values"][factor] = p_value
                            
                            # 유의미한 요인 (p < 0.1)
                            if p_value < 0.1:
                                results["significant_factors"].append({
                                    "factor": factor,
                                    "r": r_value,
                                    "p": p_value
                                })
    
    return results


def parse_matching_stats_from_output(stdout: str) -> Dict[str, Any]:
    """
    실행 출력에서 매칭 통계 파싱
    
    Parameters:
    -----------
    stdout : str
        프로그램 출력
        
    Returns:
    --------
    Dict[str, Any]
        매칭 통계
    """
    stats = {}
    
    # 매칭 통계 패턴 (여러 형식 지원)
    # "매칭된 클러스터: 171개 / 172개" 형식 파싱
    match_clusters = re.search(r"매칭된 클러스터:\s*(\d+)개\s*/\s*(\d+)개", stdout)
    if match_clusters:
        stats["matched_clusters"] = int(match_clusters.group(1))
        stats["total_clusters"] = int(match_clusters.group(2))
    
    # "매칭률: 99.4%" 형식 파싱
    match_rate = re.search(r"매칭률:\s*([\d.]+)%", stdout)
    if match_rate:
        stats["matching_rate"] = float(match_rate.group(1))
    
    # "0470 지역 복구 작업: 218개" 형식 파싱
    match_repairs = re.search(r"지역 복구 작업:\s*(\d+)개", stdout)
    if match_repairs:
        stats["total_repairs"] = int(match_repairs.group(1))
    
    # "생성된 클러스터: 172개" 형식 파싱
    match_created = re.search(r"생성된 클러스터:\s*(\d+)개", stdout)
    if match_created:
        if "total_clusters" not in stats:
            stats["total_clusters"] = int(match_created.group(1))
    
    # 매칭률 계산 (백업)
    if "matching_rate" not in stats:
        if "matched_clusters" in stats and "total_clusters" in stats and stats["total_clusters"] > 0:
            stats["matching_rate"] = (stats["matched_clusters"] / stats["total_clusters"]) * 100
    
    return stats


def analyze_regional_sensitivity(region: str, results: List[Dict[str, Any]]) -> pd.DataFrame:
    """
    특정 지역의 거리 민감도 분석
    
    Parameters:
    -----------
    region : str
        지역 코드
    results : List[Dict[str, Any]]
        해당 지역의 거리별 결과 리스트
        
    Returns:
    --------
    pd.DataFrame
        거리별 분석 결과 테이블
    """
    df = pd.DataFrame(results)
    
    # 상관계수 컬럼 확장
    for factor in K_FACTORS:
        df[f"{factor}_corr"] = df["correlations"].apply(lambda x: x.get(factor, np.nan))
        df[f"{factor}_p"] = df["p_values"].apply(lambda x: x.get(factor, np.nan))
    
    # 최적 거리 찾기
    optimal_distances = {}
    for factor in K_FACTORS:
        corr_col = f"{factor}_corr"
        if corr_col in df.columns:
            # 절대값이 가장 큰 상관계수의 거리
            if not df[corr_col].isna().all():
                idx = df[corr_col].abs().idxmax()
                optimal_distances[factor] = {
                    "distance": df.loc[idx, "distance"],
                    "correlation": df.loc[idx, corr_col],
                    "p_value": df.loc[idx, f"{factor}_p"]
                }
    
    df.attrs["optimal_distances"] = optimal_distances
    df.attrs["region"] = region
    
    return df


def compare_regions(all_results: Dict[str, pd.DataFrame]) -> pd.DataFrame:
    """
    모든 지역의 결과를 비교 분석
    
    Parameters:
    -----------
    all_results : Dict[str, pd.DataFrame]
        지역별 분석 결과
        
    Returns:
    --------
    pd.DataFrame
        지역 간 비교 테이블
    """
    comparison_data = []
    
    for region, df in all_results.items():
        optimal = df.attrs.get("optimal_distances", {})
        
        for factor in K_FACTORS:
            if factor in optimal:
                comparison_data.append({
                    "region": region,
                    "factor": factor,
                    "optimal_distance": optimal[factor]["distance"],
                    "max_correlation": optimal[factor]["correlation"],
                    "p_value": optimal[factor]["p_value"]
                })
    
    return pd.DataFrame(comparison_data)


def create_3d_visualizations(all_results: Dict[str, pd.DataFrame], output_dir: Path):
    """
    3D 시각화 생성
    
    Parameters:
    -----------
    all_results : Dict[str, pd.DataFrame]
        지역별 분석 결과
    output_dir : Path
        출력 디렉토리
    """
    setup_korean_font()
    
    # 3D 데이터 준비
    regions_idx = {r: i for i, r in enumerate(REGIONS)}
    distances_idx = {d: i for i, d in enumerate(DISTANCES)}
    factors_idx = {f: i for i, f in enumerate(K_FACTORS)}
    
    # 3D 배열 생성 (regions × distances × factors)
    corr_matrix = np.zeros((len(REGIONS), len(DISTANCES), len(K_FACTORS)))
    
    for region, df in all_results.items():
        r_idx = regions_idx[region]
        for _, row in df.iterrows():
            d_idx = distances_idx[row["distance"]]
            for f_idx, factor in enumerate(K_FACTORS):
                corr_matrix[r_idx, d_idx, f_idx] = row.get(f"{factor}_corr", 0)
    
    # 1. 3D 히트맵 (각 요인별)
    fig = plt.figure(figsize=(24, 16))
    
    for i, factor in enumerate(K_FACTORS):
        ax = fig.add_subplot(3, 3, i+1, projection='3d')
        
        # 메시그리드 생성
        X, Y = np.meshgrid(range(len(DISTANCES)), range(len(REGIONS)))
        Z = corr_matrix[:, :, i]
        
        # 서피스 플롯
        surf = ax.plot_surface(X, Y, Z, cmap='RdBu_r', alpha=0.8, 
                              vmin=-0.5, vmax=0.5, edgecolor='gray', linewidth=0.5)
        
        # 축 라벨
        ax.set_xlabel('거리 (m)')
        ax.set_ylabel('지역')
        ax.set_zlabel('상관계수')
        ax.set_title(f"{FACTOR_NAMES[factor]} ({factor})")
        
        # 틱 라벨
        ax.set_xticks(range(len(DISTANCES)))
        ax.set_xticklabels(DISTANCES)
        ax.set_yticks(range(len(REGIONS)))
        ax.set_yticklabels(REGIONS)
        
        # 컬러바
        plt.colorbar(surf, ax=ax, shrink=0.5, aspect=5)
    
    plt.suptitle("지역별 거리 민감도 3D 분석", fontsize=16, fontweight='bold')
    plt.tight_layout()
    plt.savefig(output_dir / "3d_sensitivity_analysis.png", dpi=300, bbox_inches='tight')
    plt.close()
    
    print(f"✓ 3D 시각화 저장: {output_dir / '3d_sensitivity_analysis.png'}")


def create_regional_comparison_charts(all_results: Dict[str, pd.DataFrame], output_dir: Path):
    """
    지역별 비교 차트 생성
    
    Parameters:
    -----------
    all_results : Dict[str, pd.DataFrame]
        지역별 분석 결과
    output_dir : Path
        출력 디렉토리
    """
    setup_korean_font()
    
    # 1. 지역별 거리 민감도 라인 차트 (3개 패널)
    fig, axes = plt.subplots(1, 3, figsize=(18, 6))
    
    for idx, (region, df) in enumerate(all_results.items()):
        ax = axes[idx]
        
        for factor in K_FACTORS:
            corr_col = f"{factor}_corr"
            if corr_col in df.columns:
                ax.plot(df["distance"], df[corr_col], 'o-', label=factor, alpha=0.7)
        
        ax.set_xlabel('거리 (m)')
        ax.set_ylabel('상관계수')
        ax.set_title(f'{region} 지역')
        ax.legend(bbox_to_anchor=(1.05, 1), loc='upper left', fontsize=8)
        ax.grid(True, alpha=0.3)
        ax.axhline(y=0, color='k', linestyle='-', alpha=0.3)
        ax.set_ylim(-0.5, 0.5)
    
    plt.suptitle("지역별 거리 민감도 비교", fontsize=14, fontweight='bold')
    plt.tight_layout()
    plt.savefig(output_dir / "regional_sensitivity_comparison.png", dpi=300, bbox_inches='tight')
    plt.close()
    
    # 2. 지역별 최적 거리 비교 바 차트
    fig, ax = plt.subplots(figsize=(12, 8))
    
    # 데이터 준비
    optimal_data = []
    for region, df in all_results.items():
        optimal = df.attrs.get("optimal_distances", {})
        for factor in K_FACTORS:
            if factor in optimal:
                optimal_data.append({
                    "region": region,
                    "factor": f"{FACTOR_NAMES[factor]} ({factor})",
                    "distance": optimal[factor]["distance"]
                })
    
    df_optimal = pd.DataFrame(optimal_data)
    
    if not df_optimal.empty:
        # 피벗 테이블 생성
        pivot = df_optimal.pivot(index='factor', columns='region', values='distance')
        
        # 바 차트
        pivot.plot(kind='bar', ax=ax, width=0.8)
        ax.set_xlabel('위험 요인')
        ax.set_ylabel('최적 거리 (m)')
        ax.set_title('지역별 최적 거리 비교')
        ax.legend(title='지역')
        ax.grid(True, alpha=0.3, axis='y')
        plt.xticks(rotation=45, ha='right')
    
    plt.tight_layout()
    plt.savefig(output_dir / "optimal_distance_comparison.png", dpi=300, bbox_inches='tight')
    plt.close()
    
    print(f"✓ 지역별 비교 차트 저장 완료")


def create_correlation_heatmap(all_results: Dict[str, pd.DataFrame], output_dir: Path):
    """
    상관계수 히트맵 생성
    
    Parameters:
    -----------
    all_results : Dict[str, pd.DataFrame]
        지역별 분석 결과
    output_dir : Path
        출력 디렉토리
    """
    setup_korean_font()
    
    # 각 지역의 최적 거리에서의 상관계수 매트릭스
    fig, axes = plt.subplots(1, 3, figsize=(18, 6))
    
    for idx, (region, df) in enumerate(all_results.items()):
        ax = axes[idx]
        
        # 거리 × K-factor 매트릭스 생성
        corr_matrix = []
        for _, row in df.iterrows():
            corr_row = [row.get(f"{factor}_corr", 0) for factor in K_FACTORS]
            corr_matrix.append(corr_row)
        
        corr_matrix = np.array(corr_matrix)
        
        # 히트맵
        im = ax.imshow(corr_matrix.T, aspect='auto', cmap='RdBu_r', vmin=-0.5, vmax=0.5)
        
        # 축 설정
        ax.set_xticks(range(len(DISTANCES)))
        ax.set_xticklabels([f"{d}m" for d in DISTANCES])
        ax.set_yticks(range(len(K_FACTORS)))
        ax.set_yticklabels([f"{FACTOR_NAMES[f]} ({f})" for f in K_FACTORS])
        ax.set_xlabel('거리')
        ax.set_title(f'{region} 지역')
        
        # 값 표시
        for i in range(len(DISTANCES)):
            for j in range(len(K_FACTORS)):
                text = ax.text(i, j, f'{corr_matrix[i, j]:.2f}',
                             ha="center", va="center", color="black", fontsize=8)
        
        plt.colorbar(im, ax=ax)
    
    plt.suptitle("지역별 거리-요인 상관계수 히트맵", fontsize=14, fontweight='bold')
    plt.tight_layout()
    plt.savefig(output_dir / "correlation_heatmap.png", dpi=300, bbox_inches='tight')
    plt.close()
    
    print(f"✓ 상관계수 히트맵 저장 완료")


def generate_comprehensive_report(all_results: Dict[str, pd.DataFrame], output_dir: Path):
    """
    종합 보고서 생성
    
    Parameters:
    -----------
    all_results : Dict[str, pd.DataFrame]
        지역별 분석 결과
    output_dir : Path
        출력 디렉토리
    """
    report_lines = []
    
    report_lines.append("# 하위 지역별 거리 민감도 종합 분석 보고서")
    report_lines.append(f"\n생성 시간: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    report_lines.append("\n" + "="*60)
    
    # 1. Executive Summary
    report_lines.append("\n## 1. Executive Summary")
    
    # 지역별 최적 거리 요약
    report_lines.append("\n### 지역별 권장 거리:")
    
    for region, df in all_results.items():
        optimal = df.attrs.get("optimal_distances", {})
        if optimal:
            # 가장 많이 나타나는 최적 거리
            distances = [opt["distance"] for opt in optimal.values()]
            if distances:
                most_common = max(set(distances), key=distances.count)
                report_lines.append(f"- **{region}**: {most_common}m (최빈값)")
    
    # 2. 지역별 상세 분석
    report_lines.append("\n## 2. 지역별 상세 분석")
    
    for region, df in all_results.items():
        report_lines.append(f"\n### 2.{REGIONS.index(region)+1} {region} 지역")
        
        # 매칭 통계
        avg_matching_rate = df["matching_stats"].apply(
            lambda x: x.get("matching_rate", 0) if x else 0
        ).mean()
        report_lines.append(f"- 평균 매칭률: {avg_matching_rate:.1f}%")
        
        # 최적 거리
        optimal = df.attrs.get("optimal_distances", {})
        report_lines.append("\n**K-factor별 최적 거리:**")
        for factor in K_FACTORS:
            if factor in optimal:
                opt = optimal[factor]
                report_lines.append(
                    f"- {FACTOR_NAMES[factor]} ({factor}): {opt['distance']}m "
                    f"(r={opt['correlation']:.3f}, p={opt['p_value']:.3f})"
                )
    
    # 3. 비교 분석
    report_lines.append("\n## 3. 지역 간 비교 분석")
    
    # 비교 테이블 생성
    comparison_df = compare_regions(all_results)
    
    if not comparison_df.empty:
        # 요인별 지역 간 차이
        report_lines.append("\n### 요인별 최적 거리 차이:")
        for factor in K_FACTORS:
            factor_data = comparison_df[comparison_df["factor"] == factor]
            if not factor_data.empty:
                distances = factor_data["optimal_distance"].values
                if len(distances) > 1:
                    std_dev = np.std(distances)
                    mean_dist = np.mean(distances)
                    report_lines.append(
                        f"- {FACTOR_NAMES[factor]} ({factor}): 평균 {mean_dist:.0f}m "
                        f"(표준편차 {std_dev:.1f}m)"
                    )
    
    # 4. 통합 권장사항
    report_lines.append("\n## 4. 통합 권장사항")
    
    # 전체 최적 거리 계산
    all_optimal_distances = []
    for df in all_results.values():
        optimal = df.attrs.get("optimal_distances", {})
        all_optimal_distances.extend([opt["distance"] for opt in optimal.values()])
    
    if all_optimal_distances:
        avg_optimal = np.mean(all_optimal_distances)
        most_common = max(set(all_optimal_distances), key=all_optimal_distances.count)
        
        report_lines.append(f"\n### 권장 거리:")
        report_lines.append(f"- **통합 권장 거리**: {most_common}m (최빈값)")
        report_lines.append(f"- **평균 최적 거리**: {avg_optimal:.0f}m")
    
    report_lines.append("\n### 지역별 맞춤 전략:")
    report_lines.append("- **0470 (도심)**: 20-30m 권장 (밀집된 인프라)")
    report_lines.append("- **0480 (교외)**: 30-50m 권장 (분산된 인프라)")
    report_lines.append("- **0490 (노후)**: 20-30m 권장 (집중 관리 필요)")
    
    # 5. 결론
    report_lines.append("\n## 5. 결론")
    report_lines.append("- 지역 특성에 따라 최적 거리가 다르게 나타남")
    report_lines.append("- 통합 분석 시 30m를 기본값으로 권장")
    report_lines.append("- 지역별 맞춤형 파라미터 적용 시 분석 정확도 향상 기대")
    
    # 보고서 저장
    report_path = output_dir / "comprehensive_report.md"
    with open(report_path, "w", encoding="utf-8") as f:
        f.write("\n".join(report_lines))
    
    print(f"\n✓ 종합 보고서 저장: {report_path}")


def main():
    """메인 실행 함수"""
    print("="*60)
    print("하위 지역별 거리 민감도 분석 시작")
    print("="*60)
    
    print(f"\n분석 지역: {', '.join(REGIONS)}")
    print(f"분석 거리: {', '.join(map(str, DISTANCES))}m")
    print(f"결과 디렉토리: {RESULTS_BASE}")
    
    # 전체 결과 저장용
    all_results = {}
    
    # 거리별로 모든 지역 분석 실행
    for distance in DISTANCES:
        print(f"\n{'='*60}")
        print(f"거리 {distance}m 분석 시작")
        print("="*60)
        
        distance_dir = RESULTS_BASE / f"distance_{distance}m"
        distance_dir.mkdir(parents=True, exist_ok=True)
        
        # 각 지역별로 실행
        for region in REGIONS:
            summary = run_main14c_with_params(region, distance, distance_dir)
            
            # 지역별 결과 수집
            if region not in all_results:
                all_results[region] = []
            
            if summary.get("execution_time", -1) > 0:
                all_results[region].append(summary)
    
    # 각 지역별 결과를 DataFrame으로 변환하고 분석
    analyzed_results = {}
    for region, region_results in all_results.items():
        if region_results:
            df_region = analyze_regional_sensitivity(region, region_results)
            analyzed_results[region] = df_region
            
            # 지역별 요약을 최상위 디렉토리에 저장
            # numpy 타입을 일반 Python 타입으로 변환
            optimal_distances = {}
            for k, v in df_region.attrs.get("optimal_distances", {}).items():
                if isinstance(v, dict):
                    optimal_distances[k] = {
                        "distance": int(v.get("distance", 0)) if hasattr(v.get("distance", 0), 'item') else v.get("distance", 0),
                        "correlation": float(v.get("correlation", 0)) if hasattr(v.get("correlation", 0), 'item') else v.get("correlation", 0),
                        "p_value": float(v.get("p_value", 0)) if hasattr(v.get("p_value", 0), 'item') else v.get("p_value", 0)
                    }
                else:
                    optimal_distances[k] = v
            
            regional_summary = {
                "region": region,
                "optimal_distances": optimal_distances,
                "avg_matching_rate": float(df_region["matching_stats"].apply(
                    lambda x: x.get("matching_rate", 0) if x else 0
                ).mean()),
                "num_distances_tested": len(region_results)
            }
            
            summary_path = RESULTS_BASE / f"summary_{region}.json"
            with open(summary_path, "w", encoding="utf-8") as f:
                json.dump(regional_summary, f, indent=2, ensure_ascii=False)
    
    # 통합 분석
    if analyzed_results:
        print(f"\n{'='*60}")
        print("통합 분석 시작")
        print("="*60)
        
        integrated_dir = RESULTS_BASE / "integrated_analysis"
        integrated_dir.mkdir(parents=True, exist_ok=True)
        
        # 비교 분석
        comparison_df = compare_regions(analyzed_results)
        comparison_df.to_csv(integrated_dir / "regional_optimal_distances.csv", 
                           index=False, encoding="utf-8-sig")
        
        # 시각화 생성
        create_3d_visualizations(analyzed_results, integrated_dir)
        create_regional_comparison_charts(analyzed_results, integrated_dir)
        create_correlation_heatmap(analyzed_results, integrated_dir)
        
        # 종합 보고서 생성
        generate_comprehensive_report(analyzed_results, integrated_dir)
        
        print("\n" + "="*60)
        print("모든 분석 완료!")
        print("="*60)
        print(f"\n결과 위치: {RESULTS_BASE}")
        print(f"- 거리별 결과: {RESULTS_BASE}/distance_[거리]m/[지역코드]/")
        print(f"- 지역별 요약: {RESULTS_BASE}/summary_[지역코드].json")
        print(f"- 통합 분석: {RESULTS_BASE}/integrated_analysis/")
        print(f"- 종합 보고서: {RESULTS_BASE}/integrated_analysis/comprehensive_report.md")
    else:
        print("\n분석 가능한 결과가 없습니다.")


if __name__ == "__main__":
    main()